{
  "name": "monopoly-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime Monopoly game server (Express + Socket.IO + TypeScript)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:socket": "node scripts/socket-scenarios.js",
    "test:cards": "node scripts/cards-scenarios.js",
    "test:auth": "node scripts/auth-scenarios.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.17",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "ts-node-dev": "^2.0.0"
  }
}
